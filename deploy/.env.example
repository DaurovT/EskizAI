# Переменные для deploy/docker-compose.yml.
# Локально: cp deploy/.env.example deploy/.env (без файла работают значения по умолчанию).
# На сервере: /opt/mebel/deploy/.env, права 600, в git не попадает. Подробнее — deploy/README.md.

# ---------- общее ----------
# Имя проекта Compose (префикс контейнеров и томов)
COMPOSE_PROJECT_NAME=mebel

# dev | test | prod. В prod API не стартует с dev-секретами и AUTH_CODE_PROVIDER=dev.
# ENV=dev — только локально: с публичным PUBLIC_API_URL (не localhost / LAN / *.local) API не стартует.
ENV=dev

# ---------- Postgres ----------
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel
# DATABASE_URL для api собирается в docker-compose.yml из трёх строк выше:
#   postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# (пароль — без символов @ : / ? #, иначе его нужно URL-кодировать)

# ---------- Redis (пока не используется API: очередь задач в процессе) ----------
REDIS_URL=redis://redis:6379/0

# ---------- вход и токены ----------
# В prod — случайная строка ≥ 32 символов: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# dev (код в лог; код 00000 принимается только при ENV=dev и AUTH_CODE_PROVIDER=dev) | eskiz (SMS) |
# telegram (Telegram Gateway — пока заглушка, без токена код уходит SMS)
AUTH_CODE_PROVIDER=dev
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RESEND_SECONDS=60
# Защита от SMS-накрутки (номера без аккаунта; IP — как его видит uvicorn за Caddy). 0 — без лимита.
# Блок номеров — 10 000 подряд (+99890123xxxx). Новые номера тратят не больше SMS_NEW_NUMBERS_SHARE общего
# лимита SMS (sms_per_hour / sms_per_day в админке) — остаток всегда остаётся на вход существующих мастеров.
AUTH_CODE_IP_PER_10MIN=10
AUTH_CODE_IP_PER_DAY=60
AUTH_CODE_PREFIX_PER_HOUR=10
AUTH_CODE_PREFIX_PER_DAY=30
SMS_NEW_NUMBERS_SHARE=0.7
# Неверных кодов на номер за 24 ч — после этого вход по номеру закрыт до конца суточного окна
AUTH_CODE_MAX_FAILURES_PER_DAY=15
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
# Текст SMS — строго как одобренный шаблон в кабинете Eskiz; {code} — код. Пусто = шаблон по умолчанию
ESKIZ_TEMPLATE=
TELEGRAM_GATEWAY_TOKEN=

# Старый общий токен админки (заголовок X-Admin-Token). По умолчанию ВЫКЛЮЧЕН: вход в админку — по почте,
# паролю и 2FA, первого суперадмина создаёт scripts/create_staff.py (см. ниже). Если всё же включить (true):
# в prod ADMIN_TOKEN не короче 32 символов (openssl rand -hex 32), иначе API не стартует; токен даёт только
# чтение и повседневные дела — сотрудники, настройки, лимиты, поставщики, деньги и «глазами мастера» им закрыты.
ADMIN_TOKEN=dev-admin-token
ADMIN_TOKEN_ENABLED=false
# 2FA обязательна для суперадмина; false — только временно
SUPERADMIN_MFA_REQUIRED=true

# ---------- сотрудники платформы и поставщиков (docs/staff_vendor_contract.md) ----------
# Первый суперадмин: docker compose exec api python scripts/create_staff.py --email … --name … --role superadmin
# (печатает временный пароль; при первом входе — смена пароля и обязательная 2FA)
STAFF_ACCESS_TTL_MINUTES=30
STAFF_REFRESH_TTL_DAYS=14
# Блокировка входа: столько неверных паролей подряд → вход закрыт на STAFF_LOCKOUT_MINUTES минут
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_MINUTES=15
# Название в приложении-аутентификаторе
STAFF_MFA_ISSUER=Eskiz AI
# «Глазами мастера» (только чтение): срок короткого токена, минут
IMPERSONATION_TTL_MINUTES=15
# Источник цен поставщика по ссылке/API: проверка расписания в процессе API (иначе — cron:
# python scripts/run_price_sources.py). Загрузка — только https и публичные адреса.
PRICE_SOURCE_SCHEDULER=false
PRICE_SOURCE_MAX_BYTES=10485760
PRICE_SOURCE_TIMEOUT_SECONDS=20

# ---------- файлы ----------
# local — папка в томе media (отдаётся API по /media); s3 — в API пока заглушка.
STORAGE_BACKEND=local
MEDIA_DIR=/data/media
MEDIA_BASE_URL=/media
# S3-совместимое хранилище. Локально — MinIO из compose; в проде — объектное хранилище в ЕС
# (например, Hetzner Object Storage, регион fsn1/nbg1/hel1).
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mebel
S3_ACCESS_KEY=mebel-minio
S3_SECRET_KEY=mebel-minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/mebel
# Учётка MinIO (только локально; должна совпадать с S3_ACCESS_KEY/S3_SECRET_KEY)
MINIO_ROOT_USER=mebel-minio
MINIO_ROOT_PASSWORD=mebel-minio-secret

# ---------- лимиты и ссылки клиента ----------
FREE_PROJECTS_PER_MONTH=3
LIMIT_TIMEZONE=Asia/Tashkent
# Страница ссылки в web — /p/{token}
SHARE_BASE_URL=http://localhost:3000/p
SHARE_DEFAULT_DAYS=30
# Публичный адрес API (https://<API_DOMAIN>): ссылки на GLB для AR и на файлы
PUBLIC_API_URL=http://localhost:8000
# JSON-список адресов фронтенда. В prod: ["https://app.eskizai.uz","https://admin.eskizai.uz","https://vendor.eskizai.uz"]
CORS_ORIGINS=["http://localhost:3000"]
# thread (по умолчанию) | inline
TASK_QUEUE_MODE=thread

# ---------- ИИ ----------
# Без ключа ИИ-эндпоинты отвечают 503, остальное работает.
ANTHROPIC_API_KEY=
AI_BUDGET_USD=0.30
AI_WARN_RATIO=0.8
AI_PHOTO_LIMIT=5
# Лимиты ИИ на цех ($). Общий дневной и дневной на цех — в админке (/admin/limits); здесь — защита общего
# лимита от одного цеха. «Новый» цех — без оплат платформе, без Pro и без оплаченных заказов.
AI_NEW_WORKSHOP_DAILY_USD=1.0
AI_WORKSHOP_HOURLY_USD=2.0
AI_NEW_WORKSHOP_HOURLY_USD=0.5
# Дневной лимит цеха — не больше этой доли общего дневного лимита
AI_WORKSHOP_MAX_SHARE=0.2
# Эта доля общего дневного лимита — запас платящих цехов: новым ИИ закрывается раньше
AI_PAYING_RESERVE_SHARE=0.3
# Оценка стоимости задачи, которая резервируется до её завершения (параллельные задачи не проскакивают лимит)
AI_TASK_RESERVE_USD=0.05
# «Попробовать на примере»: бюджет ИИ на все примеры цеха и сколько примеров можно создать за всё время
AI_EXAMPLE_BUDGET_USD=0.10
EXAMPLE_PROJECTS_MAX=3

# ---------- наблюдаемость ----------
# Sentry в коде API/web ещё не подключён; переменная заведена заранее.
SENTRY_DSN=

# ---------- push ----------
# log — только в лог; expo — Expo Push API (нужен EXPO_ACCESS_TOKEN)
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ---------- текстуры EMAN ----------
# Папка в томе textures; наполняется скриптами каталога (см. README в корне, раздел «Каталог EMAN»)
TEXTURES_DIR=/data/textures

# ---------- web ----------
# Пусто — web отдаёт демо-данные (/p/demo). Адрес API (без /share на конце), например
# http://api:8000 — тогда ссылка берёт данные из GET {SHARE_API_URL}/share/{token}.
SHARE_API_URL=
# Хосты кабинетов: web выбирает раздел по заголовку Host (web/src/middleware.ts).
# admin-хост: «/» → /admin, /p и /vendor — 404; vendor-хост: «/» → /vendor, /p и /admin — 404;
# остальные хосты (WEB_DOMAIN) — только /p/*. Пусто — берутся ADMIN_DOMAIN / VENDOR_DOMAIN ниже.
# Можно перечислить через запятую. Читаются при запуске контейнера, пересборка не нужна.
ADMIN_HOST=
VENDOR_HOST=
# Адрес API для браузера в админке и кабинете поставщика подставляется при СБОРКЕ (NEXT_PUBLIC_API_URL).
# Не задан — на доменах admin./vendor./app.<домен> web сам обращается к https://api.<домен>.
# NEXT_PUBLIC_API_URL=

# ---------- порты на хосте (слушают только 127.0.0.1) ----------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- прод: домены для Caddy (docker-compose.prod.yml) ----------
API_DOMAIN=api.example.uz
WEB_DOMAIN=app.example.uz
# Админка платформы и кабинет поставщика (docs/staff_vendor_contract.md); добавить оба в CORS_ORIGINS
ADMIN_DOMAIN=admin.example.uz
VENDOR_DOMAIN=vendor.example.uz
ACME_EMAIL=admin@example.uz

# ---------- бэкапы (deploy/scripts/backup.sh) ----------
BACKUP_DIR=/var/backups/mebel
BACKUP_KEEP_DAYS=14
# Необязательно: куда копировать дампы вне сервера (rclone remote:path), например hetzner-s3:mebel-backups
BACKUP_RCLONE_TARGET=
