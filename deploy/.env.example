# Переменные для deploy/docker-compose.yml.
# Локально: cp deploy/.env.example deploy/.env (без файла работают значения по умолчанию).
# На сервере: /opt/mebel/deploy/.env, права 600, в git не попадает. Подробнее — deploy/README.md.

# ---------- общее ----------
# Имя проекта Compose (префикс контейнеров и томов)
COMPOSE_PROJECT_NAME=mebel

# dev | test | prod. В prod API не стартует с dev-секретами и AUTH_CODE_PROVIDER=dev.
ENV=dev

# ---------- Postgres ----------
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel
# DATABASE_URL для api собирается в docker-compose.yml из трёх строк выше:
#   postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# (пароль — без символов @ : / ? #, иначе его нужно URL-кодировать)

# ---------- Redis (пока не используется API: очередь задач в процессе) ----------
REDIS_URL=redis://redis:6379/0

# ---------- вход и токены ----------
# В prod — случайная строка ≥ 32 символов: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# dev (код в лог, принимается 0000) | eskiz (SMS) | telegram (Telegram Gateway) — оба пока заглушки
AUTH_CODE_PROVIDER=dev
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RESEND_SECONDS=60
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
TELEGRAM_GATEWAY_TOKEN=

# Админка: общий токен в заголовке X-Admin-Token. В prod: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token

# ---------- файлы ----------
# local — папка в томе media (отдаётся API по /media); s3 — в API пока заглушка.
STORAGE_BACKEND=local
MEDIA_DIR=/data/media
MEDIA_BASE_URL=/media
# S3-совместимое хранилище. Локально — MinIO из compose; в проде — объектное хранилище в ЕС
# (например, Hetzner Object Storage, регион fsn1/nbg1/hel1).
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mebel
S3_ACCESS_KEY=mebel-minio
S3_SECRET_KEY=mebel-minio-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/mebel
# Учётка MinIO (только локально; должна совпадать с S3_ACCESS_KEY/S3_SECRET_KEY)
MINIO_ROOT_USER=mebel-minio
MINIO_ROOT_PASSWORD=mebel-minio-secret

# ---------- лимиты и ссылки клиента ----------
FREE_PROJECTS_PER_MONTH=3
LIMIT_TIMEZONE=Asia/Tashkent
# Страница ссылки в web — /p/{token}
SHARE_BASE_URL=http://localhost:3000/p
SHARE_DEFAULT_DAYS=30
# Публичный адрес API (https://<API_DOMAIN>): ссылки на GLB для AR и на файлы
PUBLIC_API_URL=http://localhost:8000
# JSON-список адресов фронтенда
CORS_ORIGINS=["http://localhost:3000"]
# thread (по умолчанию) | inline
TASK_QUEUE_MODE=thread

# ---------- ИИ ----------
# Без ключа ИИ-эндпоинты отвечают 503, остальное работает.
ANTHROPIC_API_KEY=
AI_BUDGET_USD=0.30
AI_WARN_RATIO=0.8
AI_PHOTO_LIMIT=5

# ---------- наблюдаемость ----------
# Sentry в коде API/web ещё не подключён; переменная заведена заранее.
SENTRY_DSN=

# ---------- push ----------
# log — только в лог; expo — Expo Push API (нужен EXPO_ACCESS_TOKEN)
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ---------- текстуры EMAN ----------
# Папка в томе textures; наполняется скриптами каталога (см. README в корне, раздел «Каталог EMAN»)
TEXTURES_DIR=/data/textures

# ---------- web ----------
# Пусто — web отдаёт демо-данные (/p/demo). Адрес API (без /share на конце), например
# http://api:8000 — тогда ссылка берёт данные из GET {SHARE_API_URL}/share/{token}.
SHARE_API_URL=

# ---------- порты на хосте (слушают только 127.0.0.1) ----------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- прод: домены для Caddy (docker-compose.prod.yml) ----------
API_DOMAIN=api.example.uz
WEB_DOMAIN=example.uz
ACME_EMAIL=admin@example.uz

# ---------- бэкапы (deploy/scripts/backup.sh) ----------
BACKUP_DIR=/var/backups/mebel
BACKUP_KEEP_DAYS=14
# Необязательно: куда копировать дампы вне сервера (rclone remote:path), например hetzner-s3:mebel-backups
BACKUP_RCLONE_TARGET=
