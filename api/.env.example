# Скопируйте в .env и поправьте под себя.

# dev | test | prod. В dev (и только с AUTH_CODE_PROVIDER=dev) код входа «00000» принимается для любого номера;
# с публичным PUBLIC_API_URL ENV=dev не стартует. Лимиты SMS и ИИ — см. deploy/.env.example.
ENV=dev

# Postgres из docker-compose.yml. Без Docker можно sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://mebel:mebel@localhost:5432/mebel
REDIS_URL=redis://localhost:6379/0

# Токены. В prod — длинная случайная строка (не меньше 32 символов).
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Код входа: dev (в лог) | eskiz (SMS, заглушка) | telegram (Telegram Gateway, заглушка)
AUTH_CODE_PROVIDER=dev
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_RESEND_SECONDS=60
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
TELEGRAM_GATEWAY_TOKEN=

# Админка (временно общий токен в заголовке X-Admin-Token)
ADMIN_TOKEN=dev-admin-token

# Файлы: local (папка MEDIA_DIR, отдаётся по /media) | s3 (заглушка)
STORAGE_BACKEND=local
MEDIA_DIR=./media
MEDIA_BASE_URL=/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Лимиты и ссылки клиента
FREE_PROJECTS_PER_MONTH=3
LIMIT_TIMEZONE=Asia/Tashkent
SHARE_BASE_URL=http://localhost:3000/p
# Публичный адрес API: из него строятся ссылки на GLB для AR в ссылке клиента
PUBLIC_API_URL=http://localhost:8000
SHARE_DEFAULT_DAYS=30

# JSON-список адресов фронтенда
CORS_ORIGINS=["http://localhost:3000"]

# Очередь задач: thread — фоновый поток (POST сразу отвечает 202), inline — сразу (тесты)
TASK_QUEUE_MODE=thread

# ИИ (Claude API). Без ключа ИИ-эндпоинты отвечают 503. Бюджет на проект — по умолчанию,
# админка переопределяет его в /admin/settings
ANTHROPIC_API_KEY=
AI_BUDGET_USD=0.30
AI_WARN_RATIO=0.8

# Push (раздел 19): log — только лог, expo — Expo Push API
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
