{
  "name": "@mebel/app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_MOCK=1 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "run:android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "tsc -p scripts/tsconfig.e2e.json && node .e2e-build/scripts/e2e.js",
    "viewer:build": "npm --prefix ../viewer run build",
    "export:android": "expo export --platform android --output-dir dist-export",
    "doctor": "expo-doctor",
    "prestart": "npm run viewer:build",
    "prestart:mock": "npm run viewer:build",
    "preexport:android": "npm run viewer:build"
  },
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@mebel/viewer": "file:../viewer",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-three/fiber": "9.8.2",
    "expo": "58.0.22",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.19",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-gl": "58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.7",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-share-intent": "9.0.0",
    "expo-sharing": "58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "58.0.4",
    "query-string": "7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-view-shot": "6.1.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/three": "0.169.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "typescript": "6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
