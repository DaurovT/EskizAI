{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../schemas/samples/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".e2e-build"
  ]
}
