{
  "$defs": {
    "Back": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "nailed",
          "description": "nailed — ХДФ на гвоздях сзади, none — без стенки",
          "enum": [
            "nailed",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material": {
          "default": "hdf_3_white",
          "title": "Material",
          "type": "string"
        }
      },
      "title": "Back",
      "type": "object"
    },
    "Body": {
      "additionalProperties": false,
      "properties": {
        "material": {
          "default": "ldsp_16_white",
          "description": "Материал корпуса (id из каталога)",
          "title": "Material",
          "type": "string"
        },
        "top": {
          "default": "between",
          "description": "between — крыша между боковинами, over — крыша накладная, на боковины",
          "enum": [
            "between",
            "over"
          ],
          "title": "Top",
          "type": "string"
        },
        "plinth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Plinth"
            },
            {
              "type": "null"
            }
          ],
          "description": "Цоколь; null — боковины и дно на полу"
        },
        "back": {
          "$ref": "#/$defs/Back"
        },
        "cornice": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cornice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Карниз сверху по фасаду"
        }
      },
      "title": "Body",
      "type": "object"
    },
    "Builtin": {
      "additionalProperties": false,
      "description": "Встроенный шкаф: корпус целиком (боковины, крыша, дно) стоит в нише, щели до стен и потолка закрыты\nдоборами. Ширина и высота изделия — размеры корпуса (без доборов).",
      "properties": {
        "niche": {
          "$ref": "#/$defs/Niche",
          "description": "Замер ниши; пусто — доборы номинальной ширины"
        },
        "fillers": {
          "description": "Где доборы: left / right — у стен, top — до потолка. Без добора — монтажный зазор",
          "items": {
            "enum": [
              "left",
              "right",
              "top"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Fillers",
          "type": "array"
        },
        "filler_width": {
          "default": 50,
          "description": "Видимая ширина бокового добора в самом узком месте ниши, мм (по ней подгоняется корпус)",
          "maximum": 300,
          "minimum": 0,
          "title": "Filler Width",
          "type": "number"
        },
        "top_filler_width": {
          "default": 50,
          "description": "Видимая высота верхнего добора, мм",
          "maximum": 500,
          "minimum": 0,
          "title": "Top Filler Width",
          "type": "number"
        },
        "allowance_side": {
          "default": 10,
          "description": "Монтажный зазор до стены там, где нет добора, мм",
          "maximum": 50,
          "minimum": 0,
          "title": "Allowance Side",
          "type": "number"
        },
        "allowance_top": {
          "default": 20,
          "description": "Монтажный зазор до потолка без добора, мм",
          "maximum": 100,
          "minimum": 0,
          "title": "Allowance Top",
          "type": "number"
        },
        "scribe": {
          "default": 15,
          "description": "Припуск добора на подрезку по стене, мм (мастер подрезает на месте)",
          "maximum": 40,
          "minimum": 0,
          "title": "Scribe",
          "type": "number"
        },
        "filler_material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Материал доборов (id); null — как фасады",
          "title": "Filler Material"
        },
        "filler_position": {
          "default": "flush",
          "description": "flush — заподлицо с фасадами, setback — утоплен за плоскость фасадов",
          "enum": [
            "flush",
            "setback"
          ],
          "title": "Filler Position",
          "type": "string"
        },
        "filler_setback": {
          "default": 20,
          "description": "На сколько утоплен добор при setback, мм",
          "maximum": 100,
          "minimum": 0,
          "title": "Filler Setback",
          "type": "number"
        },
        "filler_mount": {
          "default": "strip",
          "description": "strip — на планке крепления (деталь из ЛДСП корпуса), screws — уголками и саморезами",
          "enum": [
            "strip",
            "screws"
          ],
          "title": "Filler Mount",
          "type": "string"
        },
        "wedge": {
          "description": "Доборы клином: кромка к стене режется по замеру (трапеция по ширинам вверху/посередине/внизу, верхний — по высотам слева/справа), подрезать на месте почти не нужно",
          "items": {
            "enum": [
              "left",
              "right",
              "top"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Wedge",
          "type": "array"
        }
      },
      "title": "Builtin",
      "type": "object"
    },
    "Corners": {
      "additionalProperties": false,
      "properties": {
        "radius": {
          "default": 0,
          "description": "Скругление углов фасада, мм",
          "maximum": 200,
          "minimum": 0,
          "title": "Radius",
          "type": "number"
        }
      },
      "title": "Corners",
      "type": "object"
    },
    "Cornice": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 80,
          "description": "Высота карниза, мм (входит в общую высоту шкафа)",
          "maximum": 250,
          "minimum": 40,
          "title": "Height",
          "type": "number"
        }
      },
      "title": "Cornice",
      "type": "object"
    },
    "Cutout": {
      "additionalProperties": false,
      "description": "Сквозной прямоугольный вырез (ручка-вырез, розетка, труба).",
      "properties": {
        "op": {
          "const": "cutout",
          "default": "cutout",
          "title": "Op",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "x": {
          "description": "Левый нижний угол выреза от угла детали, мм (чистовые координаты)",
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "description": "Размер вдоль длины детали, мм",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "description": "Размер вдоль ширины детали, мм",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "radius": {
          "default": 0,
          "description": "Скругление углов выреза, мм",
          "minimum": 0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "part",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Cutout",
      "type": "object"
    },
    "Doors": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "default": 1,
          "description": "Сколько распашных дверей на секцию",
          "enum": [
            1,
            2
          ],
          "title": "Count",
          "type": "integer"
        },
        "hinge": {
          "default": "left",
          "description": "Сторона петель для одной двери",
          "enum": [
            "left",
            "right"
          ],
          "title": "Hinge",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Стиль только этих дверей; null — как у фасадов изделия"
        }
      },
      "title": "Doors",
      "type": "object"
    },
    "DrawersFill": {
      "additionalProperties": false,
      "description": "Ящики на шариковых направляющих.",
      "properties": {
        "kind": {
          "const": "drawers",
          "default": "drawers",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "description": "Сколько ящиков в зоне",
          "maximum": 6,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "external": {
          "default": false,
          "description": "true — у ящиков свои фасады снаружи; false — внутренние ящики за дверью",
          "title": "External",
          "type": "boolean"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Высота зоны в свету, мм. Не задана — делится поровну из остатка высоты секции",
          "title": "Height"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Стиль фасадов этих ящиков; null — как у изделия"
        }
      },
      "required": [
        "count"
      ],
      "title": "DrawersFill",
      "type": "object"
    },
    "EmptyFill": {
      "additionalProperties": false,
      "description": "Пустая зона (открытая ниша или место под технику).",
      "properties": {
        "kind": {
          "const": "empty",
          "default": "empty",
          "title": "Kind",
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Высота зоны в свету, мм. Не задана — делится поровну из остатка высоты секции",
          "title": "Height"
        },
        "doors": {
          "anyOf": [
            {
              "$ref": "#/$defs/Doors"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Двери только на эту зону (например, тумба с дверцами внизу под открытыми полками); null — как у секции"
        }
      },
      "title": "EmptyFill",
      "type": "object"
    },
    "EndUnit": {
      "additionalProperties": false,
      "description": "Торцевая открытая секция со скруглёнными полками (угловой радиусный элемент).",
      "properties": {
        "side": {
          "enum": [
            "left",
            "right"
          ],
          "title": "Side",
          "type": "string"
        },
        "width": {
          "default": 300,
          "description": "Ширина секции, мм (к общей ширине корпуса прибавляется)",
          "maximum": 450,
          "minimum": 200,
          "title": "Width",
          "type": "number"
        },
        "shelves": {
          "default": 3,
          "description": "Полок между низом и верхом",
          "maximum": 8,
          "minimum": 1,
          "title": "Shelves",
          "type": "integer"
        }
      },
      "required": [
        "side"
      ],
      "title": "EndUnit",
      "type": "object"
    },
    "FrontStyle": {
      "additionalProperties": false,
      "description": "Стиль фасадов. У изделия — для всех фасадов; у двери/ящика/модуля — переопределение\n(заданное поле заменяет поле изделия целиком; pattern/kind \"none\" — выключить).",
      "properties": {
        "milling": {
          "anyOf": [
            {
              "$ref": "#/$defs/Milling"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/Overlay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inlay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Paint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "corners": {
          "anyOf": [
            {
              "$ref": "#/$defs/Corners"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FrontStyle",
      "type": "object"
    },
    "Fronts": {
      "additionalProperties": false,
      "properties": {
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Материал фасадов; null — как у корпуса",
          "title": "Material"
        },
        "handles": {
          "$ref": "#/$defs/Handles"
        },
        "style": {
          "$ref": "#/$defs/FrontStyle",
          "description": "Фрезеровка, накладной декор, вставки, покраска, скругление углов"
        }
      },
      "title": "Fronts",
      "type": "object"
    },
    "GrooveOp": {
      "additionalProperties": false,
      "description": "Паз или четверть по всей длине (или ширине) детали.",
      "properties": {
        "op": {
          "const": "groove",
          "default": "groove",
          "title": "Op",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "along": {
          "default": "length",
          "enum": [
            "length",
            "width"
          ],
          "title": "Along",
          "type": "string"
        },
        "offset": {
          "description": "Расстояние от края (y=0 или x=0) до паза, мм; 0 — четверть",
          "minimum": 0,
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "description": "Ширина паза, мм",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "description": "Глубина паза, мм",
          "exclusiveMinimum": 0,
          "title": "Depth",
          "type": "number"
        },
        "face": {
          "default": "A",
          "enum": [
            "A",
            "B"
          ],
          "title": "Face",
          "type": "string"
        }
      },
      "required": [
        "part",
        "offset",
        "width",
        "depth"
      ],
      "title": "GrooveOp",
      "type": "object"
    },
    "Handles": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "bar",
          "description": "none — без ручек (push), bar — скоба, knob — кнопка (грибок), gola — профиль Gola",
          "enum": [
            "none",
            "bar",
            "knob",
            "gola"
          ],
          "title": "Kind",
          "type": "string"
        },
        "spacing": {
          "default": 128,
          "description": "Межосевое расстояние скобы, мм",
          "enum": [
            96,
            128,
            160,
            192,
            256,
            320
          ],
          "title": "Spacing",
          "type": "integer"
        },
        "finish": {
          "default": "steel",
          "description": "Отделка ручек",
          "enum": [
            "steel",
            "black",
            "chrome",
            "brass",
            "gold"
          ],
          "title": "Finish",
          "type": "string"
        }
      },
      "title": "Handles",
      "type": "object"
    },
    "HardwareChoice": {
      "additionalProperties": false,
      "description": "Фурнитура изделия (FR-46): тип и класс. Конкретные позиции подбирает ядро по правилам.",
      "properties": {
        "hinge": {
          "default": "soft_close",
          "description": "Петли: standard — без доводчика, soft_close — с доводчиком, push — push-to-open",
          "enum": [
            "standard",
            "soft_close",
            "push"
          ],
          "title": "Hinge",
          "type": "string"
        },
        "hinge_class": {
          "default": "standard",
          "enum": [
            "econom",
            "standard",
            "premium"
          ],
          "title": "Hinge Class",
          "type": "string"
        },
        "slides": {
          "default": "ball",
          "description": "Направляющие ящиков: ball — шариковые, hidden_full — скрытые полного выдвижения, hidden_soft — скрытые с доводчиком",
          "enum": [
            "ball",
            "hidden_full",
            "hidden_soft"
          ],
          "title": "Slides",
          "type": "string"
        },
        "slides_class": {
          "default": "standard",
          "enum": [
            "econom",
            "standard",
            "premium"
          ],
          "title": "Slides Class",
          "type": "string"
        }
      },
      "title": "HardwareChoice",
      "type": "object"
    },
    "Inlay": {
      "additionalProperties": false,
      "description": "Металлическая вставка: латунная рамка, золотой кант по краю, полоса.",
      "properties": {
        "kind": {
          "default": "none",
          "description": "frame — рамка, line_h / line_v — полоса поперёк / вдоль, edge — кант по периметру фасада",
          "enum": [
            "none",
            "frame",
            "line_h",
            "line_v",
            "edge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "finish": {
          "default": "brass",
          "enum": [
            "brass",
            "gold",
            "black",
            "chrome"
          ],
          "title": "Finish",
          "type": "string"
        },
        "width": {
          "default": 6,
          "description": "Ширина профиля, мм",
          "maximum": 20,
          "minimum": 2,
          "title": "Width",
          "type": "number"
        },
        "inset": {
          "default": 40,
          "description": "Отступ от края, мм (для edge не используется)",
          "maximum": 300,
          "minimum": 0,
          "title": "Inset",
          "type": "number"
        }
      },
      "title": "Inlay",
      "type": "object"
    },
    "Light": {
      "additionalProperties": false,
      "description": "Подсветка: светодиодная лента в алюминиевом профиле с рассеивателем.",
      "properties": {
        "zone": {
          "description": "under_wall — под навесными шкафами кухни, niche — в открытой нише (под верхом ниши), shelf — под полками, wardrobe_rod — над штангой, plinth — по цоколю, inside_top — под крышей внутри секции",
          "enum": [
            "under_wall",
            "niche",
            "shelf",
            "wardrobe_rod",
            "plinth",
            "inside_top"
          ],
          "title": "Zone",
          "type": "string"
        },
        "target": {
          "default": "all",
          "description": "all, sections[i] (шкаф), wall[i] / wall2[i] / base[i] (кухня)",
          "maxLength": 40,
          "title": "Target",
          "type": "string"
        },
        "temp": {
          "default": 4000,
          "description": "Цветовая температура, K: 3000 — тёплый, 4000 — нейтральный, 6000 — холодный",
          "enum": [
            3000,
            4000,
            6000
          ],
          "title": "Temp",
          "type": "integer"
        },
        "sensor": {
          "default": "none",
          "enum": [
            "none",
            "door",
            "motion",
            "touch"
          ],
          "title": "Sensor",
          "type": "string"
        },
        "mount": {
          "default": "groove",
          "description": "groove — профиль в паз, surface — накладной",
          "enum": [
            "groove",
            "surface"
          ],
          "title": "Mount",
          "type": "string"
        },
        "power": {
          "default": 9.6,
          "description": "Мощность ленты, Вт/м",
          "maximum": 30,
          "minimum": 2,
          "title": "Power",
          "type": "number"
        }
      },
      "required": [
        "zone"
      ],
      "title": "Light",
      "type": "object"
    },
    "Mezzanine": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "description": "Высота антресоли в свету, мм",
          "maximum": 800,
          "minimum": 200,
          "title": "Height",
          "type": "number"
        },
        "doors": {
          "default": true,
          "description": "Двери на антресоли (по одной или две на секцию — по ширине)",
          "title": "Doors",
          "type": "boolean"
        }
      },
      "required": [
        "height"
      ],
      "title": "Mezzanine",
      "type": "object"
    },
    "Milling": {
      "additionalProperties": false,
      "description": "Фрезеровка по лицевой стороне МДФ (путь фрезы строит ядро).",
      "properties": {
        "pattern": {
          "default": "none",
          "description": "shaker — рамка, classic — рамка с филёнкой, arcs — арка сверху, rhombus — ромб (на высоком фасаде — решётка), grooves_v / grooves_h — рифление, waves — волны",
          "enum": [
            "none",
            "shaker",
            "classic",
            "arcs",
            "rhombus",
            "grooves_v",
            "grooves_h",
            "waves"
          ],
          "title": "Pattern",
